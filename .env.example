# Google Gemini: server-side only. Never prefix this key with VITE_.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
VALIDATOR_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
AI_MAX_ATTEMPTS=4
AI_CALL_GAP_MS=750

# SEC requests require an identifiable user agent.
EDGAR_USER_AGENT="AdvisorBrief public-demo https://aiqorx.com/contact"

# Runtime behavior
VALIDATION_POLICY=exclude
UNVERIFIED_POLICY=hide
RESEARCH_TIMEOUT_MS=120000
VALIDATOR_TIMEOUT_MS=75000
ASK_TIMEOUT_MS=60000
EMBED_TIMEOUT_MS=30000
ENABLE_EMBEDDINGS=false
MEMORY_TTL_MS=21600000
RATE_LIMIT_BRIEFS_PER_10M=12
RATE_LIMIT_ASKS_PER_10M=40
DEBUG_ERRORS=false

# Optional durable memory. The default is isolated in-process memory.
MEMORY_BACKEND=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional browser-side Supabase configuration. Publishable keys are not privileged, but keep live
# project configuration in an ignored .env.local file rather than committing it.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
